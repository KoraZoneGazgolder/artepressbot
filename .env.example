BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Необязательно: если задан, этот аккаунт сразу станет админом.
# Иначе админом станет первый, кто напишет /start.
ADMIN_TELEGRAM_ID=
TZ=Europe/Moscow
DB_PATH=/app/data/diary.db
SNOOZE_MINUTES=20
BP_MORNING=09:00
BP_EVENING=20:00
# Бэкапы БД: куда складывать, сколько файлов держать, во сколько (локальное время TZ)
BACKUP_DIR=/app/data/backups
BACKUP_KEEP=14
BACKUP_TIME=03:30
# Через сколько дней без замеров напомнить пользователю
BP_INACTIVE_DAYS=3
